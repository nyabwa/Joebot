SEND_SERVER_HOST=127.0.0.1
SEND_SERVER_PORT=5001

# Flask -> local WhatsApp control API. Match the root .env.
JOEBOT_CONTROL_TOKEN=

# Local WhatsApp -> Flask internal API. Match the root .env.
JOEBOT_INTERNAL_TOKEN=
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# CrewAI dashboard integration.
# CREWAI_JOEBOT_TOKEN must match JOEBOT_API_TOKEN in /home/joe-joe/crewai-dashboard/.env when that token is set.
CREWAI_DASHBOARD_URL=http://127.0.0.1:8000
CREWAI_JOEBOT_TOKEN=
CREWAI_REQUEST_TIMEOUT_MS=180000

WA_MAX_DOWNLOAD_MB=50
WA_ANTI_DELETE_MEDIA_MAX_MB=50
WA_MESSAGE_TTL_MS=86400000
YTDLP_PATH=/usr/local/bin/yt-dlp
YTDLP_COOKIES_PATH=
YTDLP_PROXY_URL=
# Comma-separated input domains that should use YTDLP_PROXY_URL.
YTDLP_PROXY_DOMAINS=youtube.com,youtu.be
