SUPABASE_URL=
SUPABASE_KEY=
GROQ_API_KEY=
ALLOWED_GROUPS=

# JoeBot browser dashboard.
DASHBOARD_PASSWORD=
FLASK_SECRET_KEY=
DASHBOARD_SECURE_COOKIES=false

# Optional shared secret for Flask -> local WhatsApp control API.
# If set here, set the same value in whatsapp/.env.
JOEBOT_CONTROL_TOKEN=
JOEBOT_CONTROL_URL=http://127.0.0.1:5001/control

FLASK_DEBUG=false
